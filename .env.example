# ── Backend selection ────────────────────────────────────────────────────
# local    = authoritative engine runs inside the Vite dev server (no credentials)
# supabase = production Supabase Postgres + Auth + Realtime
VITE_BACKEND=local

# ── Required only when VITE_BACKEND=supabase ─────────────────────────────
# Anonymous Sign-ins must be enabled in the dashboard (Authentication → Sign In
# / Providers → Anonymous sign-ins). There are no operator users and no emails:
# access is granted by the invitation links minted with scripts/mint-invites.ps1.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# ── Self-hosted (local) operator passcodes ───────────────────────────────
# Built-in default is the shared duty code 3110 for all five stations. Set any
# variable below to give that station its own code for a real event, and never
# commit the replacements.
SC_PASSCODE_LOBBY=3110
SC_PASSCODE_GATE=3110
SC_PASSCODE_CORRIDOR=3110
SC_PASSCODE_ROOM305=3110
SC_PASSCODE_SUPERVISOR=3110
# HMAC secret for the dev bearer tokens. Any long random string.
SC_TOKEN_SECRET=change-me-to-a-long-random-string
# Passcode the `?station=` development links send; must match the value above.
VITE_DEV_PASSCODE=3110

# ── Server-side service key (used only by supabase CLI migrations) ───────
SUPABASE_SERVICE_ROLE_KEY=
